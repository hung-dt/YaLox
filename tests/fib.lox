fun durationFrom(s) {
    print clock() - s;
}

// recursive function to calculate Fibonacci numbers
fun fib(n) {
  if (n < 2) return n;
  return fib(n - 1) + fib(n - 2);
}

print "Fibonacci numbers:";

var start = clock();
